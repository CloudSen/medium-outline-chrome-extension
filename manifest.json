{
  "manifest_version": 3,
  "name": "Medium Article Outline",
  "description": "Adds a left-hand outline sidebar to Medium-powered articles.",
  "version": "0.1.2",
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
